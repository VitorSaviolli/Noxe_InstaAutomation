# Copie para .dev.vars e preencha com valores REAIS para desenvolvimento local.
# O .dev.vars e ignorado pelo git e NUNCA deve ser commitado.
#
# Em producao estes valores vao por `npx wrangler secret put <NOME>`.

# App Secret do app da Meta. Assina os webhooks (X-Hub-Signature-256)
# e e usado na troca de code por token no OAuth.
META_APP_SECRET=

# Valor que voce inventa e informa no painel de webhooks da Meta.
# Gere com: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
META_WEBHOOK_VERIFY_TOKEN=

# Chave AES-GCM de 32 bytes em base64. Cifra o access token guardado no D1.
# Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Protege as rotas administrativas (/setup/*). Enviado como Authorization: Bearer.
# Gere com: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SETUP_ADMIN_TOKEN=

# Raiz das quatro subchaves do painel administrativo (sessao, desafio, csrf e
# codigos). Ela NAO pode repetir o SETUP_ADMIN_TOKEN nem o
# TOKEN_ENCRYPTION_KEY: rotacionar o admin token nao pode derrubar as sessoes,
# e vazar um convite nao pode entregar a chave das sessoes.
# Minimo de 32 caracteres. Sem ela o painel responde 503 e nao existe.
# Gere com: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# ATENCAO: trocar esta chave desconecta todos os aparelhos e invalida os
# codigos de recuperacao e de parada. As passkeys nao sao afetadas.
PANEL_SESSION_KEY=
