# Referencia das variaveis do projeto. Copie para .env e preencha.
# O .env NAO e lido pelo Cloudflare Workers em runtime — serve apenas como
# anotacao local e para os scripts de apoio em scripts/.
#
# Config NAO secreta vive em src/config.ts e no wrangler.jsonc.
# Segredos vivem em .dev.vars (local) e no Cloudflare Secrets (producao).

# --- Identificadores publicos ---
META_APP_ID=
META_API_VERSION=
META_IG_USER_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
WORKER_PUBLIC_URL=

# --- Segredos: NAO preencha aqui. Use .dev.vars / wrangler secret put ---
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# TOKEN_ENCRYPTION_KEY=
# SETUP_ADMIN_TOKEN=
# CLOUDFLARE_API_TOKEN=   (opcional, somente CI/CD, como secret do GitHub)
