{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noxe-insta-automation",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",

  // ---------------------------------------------------------------------
  // Os TRES arquivos estaticos do painel, e nada alem deles.
  //
  //   /painel/painel.css   -> public/painel/painel.css
  //   /painel/painel.js    -> public/painel/painel.js
  //   /painel/parar        -> public/painel/parar/index.html
  //
  // SEM `binding` e SEM `run_worker_first`, e as duas ausencias sao decisao.
  // Com `run_worker_first` as rotas casadas passariam a invocar o Worker e
  // devolveriam 429 quando a cota estourasse — exatamente o que nao pode
  // acontecer com o arquivo da parada de emergencia.
  //
  // `not_found_handling` NUNCA pode virar "single-page-application": nesse
  // modo qualquer caminho nao encontrado devolveria o `index.html`, inclusive
  // /webhooks/instagram. E nenhum arquivo novo em public/ pode ter o caminho
  // de uma rota do Worker: o sequestro seria silencioso.
  // ---------------------------------------------------------------------
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },

  // ---------------------------------------------------------------------
  // PREENCHER: o banco D1 e SEU, o ID abaixo nao vem pronto.
  //
  // O banco guarda o cooldown por usuario, a deduplicacao de comentarios e o
  // access token cifrado. Crie o seu com:
  //   npx wrangler d1 create noxe-insta-automation
  // O comando imprime um `database_id` (um codigo com tracos, tipo
  // 1a2b3c4d-...). Cole esse codigo no lugar de COLE_AQUI_O_ID_DO_SEU_BANCO_D1.
  // Sem isso o deploy falha: o ID e unico por conta Cloudflare.
  // ---------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noxe-insta-automation",
      "database_id": "COLE_AQUI_O_ID_DO_SEU_BANCO_D1"
    }
  ],

  // UM unico cron: varre retry_pending e checa se o token precisa renovar.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // Apenas configuracao NAO secreta. Segredos vao por `wrangler secret put`.
  // ATENCAO: este bloco e SOBRESCRITO a cada deploy — editar pelo dashboard
  // nao adianta, o proximo deploy apaga. Este arquivo e a fonte da verdade.
  "vars": {
    // PREENCHER: ID publico do SEU app no Meta for Developers.
    // Onde achar: developers.facebook.com -> seu app -> Configuracoes ->
    // Basico -> campo "ID do aplicativo". E um numero longo e NAO e segredo
    // (aparece na URL do login). Troque COLE_AQUI_O_ID_DO_SEU_APP_META por ele.
    "META_APP_ID": "COLE_AQUI_O_ID_DO_SEU_APP_META",
    // Versao da Graph API. Ver README para a politica de atualizacao.
    "META_API_VERSION": "v25.0",
    // Preenchido automaticamente apos o primeiro login OAuth; deixe vazio.
    "META_IG_USER_ID": "",
    // Endereco do painel administrativo, so o host: sem "https://" e sem
    // barra no fim (ex.: "meu-worker.minha-conta.workers.dev"). E o mesmo host
    // que o navegador mostra na barra de endereco. Nasce VAZIO de proposito:
    // enquanto estiver vazio, o painel responde 503 e nao existe.
    "PANEL_RP_ID": "",
    // Dominios para os quais o painel pode apontar o link do Direct, separados
    // por virgula, em minusculas e sem "https://" (ex.: "meusite.com.br,
    // www.meusite.com.br"). Um item que comeca com ponto (".meusite.com.br")
    // tambem libera os subdominios.
    // Este bloco e SOBRESCRITO a cada deploy, e aqui isso e a protecao: mudar
    // esta lista exige o repositorio e a credencial de deploy, que e o que um
    // painel invadido nao tem. Nasce VAZIA de proposito: enquanto estiver
    // vazia, o painel NAO altera link nem texto do Direct, e a entrega segue
    // com o link que ja esta valendo.
    "ALLOWED_LINK_DOMAINS": ""
  },

  // Lista dos segredos que o Worker espera encontrar. O wrangler usa essa
  // lista para gerar os tipos e para AVISAR, durante o `npm run dev`, quando
  // algum esta faltando. E um aviso, nao um bloqueio: o deploy nao para por
  // causa disso. Confira voce mesmo com `npx wrangler secret list`.
  "secrets": {
    "required": [
      "META_APP_SECRET",
      "META_WEBHOOK_VERIFY_TOKEN",
      "TOKEN_ENCRYPTION_KEY",
      "SETUP_ADMIN_TOKEN",
      "PANEL_SESSION_KEY"
    ]
  },

  // ---------------------------------------------------------------------
  // Limitadores de tentativa do painel. Camada de defesa OPCIONAL: apagar
  // este bloco inteiro nao quebra nada — o painel continua correto e o
  // limitador de reserva (uma janela por isolate, dentro do proprio Worker)
  // assume no lugar. O que estes bindings compram e cota; a seguranca dos
  // codigos vem da entropia deles, nunca daqui.
  //
  // Sao TRES e nao um porque o `limit` e fixo por binding e o `period` so
  // aceita 10 ou 60: um binding sozinho nao consegue dar ao login um teto
  // diferente do da parada de emergencia. Baldes separados tambem garantem
  // que um bot martelando a tela de entrar NAO consuma a cota de que voce
  // precisa para digitar o codigo de parada numa emergencia.
  //
  // O `namespace_id` e um numero SEU, unico dentro deste Worker. Ele nao vem
  // de lugar nenhum da Cloudflare e nao precisa ser trocado.
  //
  // LEIA ISTO ANTES DE APAGAR O BLOCO. Sem estes tres bindings cadastrados, o
  // que resta e o limitador de reserva, e ele conta dentro de UM servidor so
  // (um "isolate") e por endereco de IP. Contra uma pessoa tentando de um
  // endereco so, ele segura. Contra trafego distribuido — muitos enderecos ao
  // mesmo tempo, que e o que um ataque de verdade faz — a protecao de cota e
  // praticamente NULA: o teto de 10 por minuto vira 10 vezes o numero de
  // enderecos vezes o numero de servidores. Nao existe teto global sem estes
  // bindings, e isso nao e um defeito escondido: e o preco de a camada ser
  // opcional.
  //
  // O que cadastrar os tres compra e exatamente isso, e nao seguranca: o
  // contador passa a ser da Cloudflare, aplicado antes de a sua cota ser
  // gasta. A cota do plano gratuito e de 100.000 requisicoes por dia, e ela e
  // o maior risco residual deste projeto — o dia em que ela acaba e o dia em
  // que a automacao para de responder. A seguranca dos codigos continua vindo
  // do tamanho deles, nunca daqui.
  // ---------------------------------------------------------------------
  "ratelimits": [
    // Entrar e registrar por convite: 10 tentativas por minuto, por IP.
    {
      "name": "PANEL_LIMITER_LOGIN",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    // Codigo de recuperacao digitado: 30 por minuto, por IP.
    {
      "name": "PANEL_LIMITER_CODIGO",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    // Parada de emergencia: 30 por minuto, por IP, num balde so dela.
    {
      "name": "PANEL_LIMITER_STOP",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true
  }
}
